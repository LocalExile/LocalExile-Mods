<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rates service: a program of its own that runs apart from any Gateway (README.md). It is not part of the mod's release, and the Gateway never loads it.
       It builds against LocalExile's GameServer.Core: LocalExile/ beside this repository, the checkout around Mods/Source/, or -p:LocalExileRoot=<path>. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>GameServer.Rates</AssemblyName>
    <LocalExileRoot Condition="'$(LocalExileRoot)' == '' And Exists('$(MSBuildThisFileDirectory)..\..\..\..\src\GameServer.Core')">$(MSBuildThisFileDirectory)..\..\..\..\</LocalExileRoot>
    <LocalExileRoot Condition="'$(LocalExileRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\LocalExile\</LocalExileRoot>
    <LocalExileDir>$([MSBuild]::EnsureTrailingSlash('$(LocalExileRoot)'))</LocalExileDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(LocalExileDir)src\GameServer.Core\GameServer.Core.csproj" />
  </ItemGroup>

</Project>
