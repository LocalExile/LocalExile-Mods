<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <LocalExileRoot Condition="'$(LocalExileRoot)' == ''">$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'GameServer.slnx'))</LocalExileRoot>
    <LocalExileRoot Condition="'$(LocalExileRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\LocalExile\</LocalExileRoot>
    <LocalExileDir>$([MSBuild]::EnsureTrailingSlash('$(LocalExileRoot)'))</LocalExileDir>
  </PropertyGroup>
</Project>
